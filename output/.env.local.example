# URL du json-server d'employes-admin (utilisé par React Admin sur /rh-admin)
# employes-admin utilise jsonplaceholder.typicode.com par défaut (voir .env d'employes-admin)
# Pour utiliser le vrai json-server local : npx json-server db.json --port 3100
NEXT_PUBLIC_JSON_SERVER_URL=https://jsonplaceholder.typicode.com
